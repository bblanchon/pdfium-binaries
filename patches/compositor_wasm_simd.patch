+// floor(x / 255), exact for x in [0, 65280], in unsigned 16-bit lanes.
+v128_t Div255U16(v128_t x) {
+  v128_t t = wasm_i16x8_add(wasm_i16x8_add(x, wasm_i16x8_splat(1)),
+                            wasm_u16x8_shr(x, 8));
+  return wasm_u16x8_shr(t, 8);
