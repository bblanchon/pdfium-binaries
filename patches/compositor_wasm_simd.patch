+// floor(x / 255), exact for x in [0, 65280], in unsigned 32-bit lanes.
+v128_t Div255U32(v128_t x) {
+  v128_t t = wasm_i32x4_add(wasm_i32x4_add(x, wasm_i32x4_splat(1)),
+                            wasm_u32x4_shr(x, 8));
+  return wasm_u32x4_shr(t, 8);
