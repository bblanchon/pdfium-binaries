+  const v128_t zero = wasm_i32x4_splat(0);
+  const v128_t one = wasm_i32x4_splat(1);
+  const v128_t c255 = wasm_i32x4_splat(255);
+  const v128_t alpha_bytes =
+      wasm_i32x4_splat(static_cast<int32_t>(0xFF000000u));
