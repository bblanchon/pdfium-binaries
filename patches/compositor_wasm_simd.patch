+// Vectorized CompositeRow_Bgr2Bgra_NoBlend_Clip and its _RgbByteOrder
+// sibling (kReverseBytes selects the RGBA-order destination), four
+// destination pixels per iteration, 3-byte-per-pixel source. The per-pixel
+// alpha comes from the clip row instead of the source pixel; the source
+// channels pass through the CopyRowToOpaqueBgraSimd 3-to-4 swizzle (byte
+// reversed for an RGBA-order destination) and then enter the same merge
+// arithmetic as CompositeRowBgra2BgraNormalNoClipSimd below, so every lane
+// matches the scalar path exactly:
+//   - clip == 0    -> dest unchanged
+//   - clip == 255  -> dest = src rgb, alpha 255
+//   - otherwise    -> dest_alpha = AlphaUnion(dest.alpha, clip)
+//                     ratio = floor(clip * 255 / dest_alpha)
+//                     rgb = AlphaMerge(dest, src, ratio), alpha = dest_alpha
+// A clip == 255 lane needs no separate mask: the general arithmetic gives
+// dest_alpha = 255, ratio = 255, and AlphaMerge(..., 255) returns the
+// source, which is exactly the scalar fast path; the same argument covers
+// the scalar dest.alpha == 0 case (dest_alpha = clip, ratio = 255). Only
+// clip == 0 becomes a mask. The variable division reuses the float32 trick
+// verified for the kernel below; the operand domain is identical
+// (numerator = clip * 255 <= 65025, divisor = AlphaUnion(..) in [1, 255]).
+//
+// A group's 16-byte source load covers bytes [12g, 12g + 16), so it stays
+// in bounds while at least six pixels remain and the last groups (up to
+// five pixels) go through the scalar tail. Clip rows are long -- the
+// corpus probe puts 84% of the pixels reaching this path in rows of 256+
+// pixels -- so there is no per-row gating.
+template <bool kReverseBytes>
+void CompositeRowBgr2BgraNoBlendClipSimd(uint8_t* dest_scan,
+                                         const uint8_t* src_scan,
+                                         int width,
+                                         const uint8_t* clip_scan) {
+  const v128_t zero = wasm_i32x4_splat(0);
+  const v128_t one = wasm_i32x4_splat(1);
+  const v128_t c255 = wasm_i32x4_splat(255);
+  const v128_t alpha_bytes =
+      wasm_i32x4_splat(static_cast<int32_t>(0xFF000000u));
+  const v128_t swz = kReverseBytes
+                         ? wasm_i8x16_const(2, 1, 0, -1, 5, 4, 3, -1, 8, 7, 6,
+                                            -1, 11, 10, 9, -1)
+                         : wasm_i8x16_const(0, 1, 2, -1, 3, 4, 5, -1, 6, 7, 8,
+                                            -1, 9, 10, 11, -1);
+
+  int col = 0;
+  UNSAFE_TODO({
+    for (; width - col >= 6; col += 4) {
+      const v128_t clip4 = wasm_v128_load32_zero(clip_scan + col);
+      if (!wasm_v128_any_true(clip4)) {
+        continue;  // All four pixels clipped out; dest unchanged.
+      }
+      const v128_t sw =
+          wasm_i8x16_swizzle(wasm_v128_load(src_scan + 3 * col), swz);
+      uint8_t* dst = dest_scan + 4 * col;
+      const v128_t sa =
+          wasm_u32x4_extend_low_u16x8(wasm_u16x8_extend_low_u8x16(clip4));
+
+      // All four pixels fully inside the clip region: plain opaque copy.
+      if (wasm_i32x4_all_true(wasm_i32x4_eq(sa, c255))) {
+        wasm_v128_store(dst, wasm_v128_or(sw, alpha_bytes));
+        continue;
+      }
+
+      const v128_t d = wasm_v128_load(dst);
+      const v128_t da = wasm_u32x4_shr(d, 24);
+      const v128_t m_skip = wasm_i32x4_eq(sa, zero);
+
+      // dest_alpha = da + sa - floor(da * sa / 255)
