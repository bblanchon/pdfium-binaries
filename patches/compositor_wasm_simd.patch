+#if defined(__wasm_simd128__)
+// Vectorized CopyRowToOpaqueBgra, four destination pixels per iteration.
+// This is a pure byte rearrangement -- three source channel bytes move into
+// a 4-byte destination pixel whose alpha byte becomes 255 -- so the kernel
+// is bit-identical to the scalar loop by construction: an i8x16.swizzle
+// gathers the twelve channel bytes of a 3-byte-pixel group into their
+// destination positions (for a 4-byte source the group's sixteen bytes are
+// loaded verbatim, or channel-swapped by the same swizzle for an RGBA
+// destination), and one OR forces every fourth byte to 255. Lane indices
+// with the high bit set make i8x16.swizzle produce zero; the alpha OR then
+// overwrites those bytes, and for a 4-byte BGRA-order source the OR alone
+// already turns the ignored source byte into 255, so no swizzle is needed
+// there at all.
+//
+// A group's 16-byte source load must stay inside the source span: for a
+// 3-byte source a group needs only bytes [12g, 12g + 12), so the load
+// overreads 4 bytes and the last groups (up to 5 pixels) go through the
+// scalar tail instead. Rows on this path are long -- the banked corpus
+// probe (comp_class_d200.tsv) puts the pixels-per-row average at 830
+// corpus-wide with a median per-document average of 503 -- and the kernel
+// hoists only two constants per row, so there is no per-row gating.
 template <typename DestPixelStruct, typename SrcPixelStruct>
+void CopyRowToOpaqueBgraSimd(pdfium::span<DestPixelStruct> dest_span,
+                             pdfium::span<const SrcPixelStruct> src_span) {
+  constexpr bool kDestBgra =
+      std::is_same_v<DestPixelStruct, FX_BGRA_STRUCT<uint8_t>>;
+  constexpr bool kDestRgba =
+      std::is_same_v<DestPixelStruct, FX_RGBA_STRUCT<uint8_t>>;
+  constexpr bool kSrcBgr =
+      std::is_same_v<SrcPixelStruct, FX_BGR_STRUCT<uint8_t>>;
+  static_assert(kDestBgra || kDestRgba);
+  static_assert(kSrcBgr ||
+                std::is_same_v<SrcPixelStruct, FX_BGRA_STRUCT<uint8_t>>);
+  constexpr size_t kSrcBpp = sizeof(SrcPixelStruct);
+  static_assert(kSrcBpp == (kSrcBgr ? 3u : 4u));
+  static_assert(sizeof(DestPixelStruct) == 4);
+
+  const size_t total = dest_span.size();
+  CHECK_LE(total, src_span.size());
+  const uint8_t* src = reinterpret_cast<const uint8_t*>(src_span.data());
+  uint8_t* dst = reinterpret_cast<uint8_t*>(dest_span.data());
+  const v128_t alpha_bytes =
+      wasm_i32x4_splat(static_cast<int32_t>(0xFF000000u));
+
+  // For a 3-byte source the load of the last in-bounds group must fit:
+  // 12g + 16 <= 3 * total, i.e. at least 6 pixels must remain. A 4-byte
+  // source loads exactly its four pixels.
+  const size_t group_min = kSrcBgr ? 6 : 4;
+  size_t i = 0;
+  UNSAFE_TODO({
+    for (; total - i >= group_min; i += 4, src += 4 * kSrcBpp, dst += 16) {
+      const v128_t s = wasm_v128_load(src);
+      v128_t out;
+      if constexpr (kSrcBgr && kDestBgra) {
+        out = wasm_i8x16_swizzle(
+            s, wasm_i8x16_const(0, 1, 2, -1, 3, 4, 5, -1, 6, 7, 8, -1, 9, 10,
+                                11, -1));
+      } else if constexpr (kSrcBgr && kDestRgba) {
+        out = wasm_i8x16_swizzle(
+            s, wasm_i8x16_const(2, 1, 0, -1, 5, 4, 3, -1, 8, 7, 6, -1, 11, 10,
+                                9, -1));
+      } else if constexpr (kDestRgba) {
+        out = wasm_i8x16_swizzle(
+            s, wasm_i8x16_const(2, 1, 0, -1, 6, 5, 4, -1, 10, 9, 8, -1, 14,
