+                                             16, 12, 16, 12, 16, 12, 16, 12,
+                                             16);
+      const v128_t rinv_lo = wasm_i16x8_sub(wasm_i16x8_splat(255), r_lo);
+      const v128_t rinv_hi = wasm_i16x8_sub(wasm_i16x8_splat(255), r_hi);
