+      // ratio = floor(sa * 255 / dest_alpha)
+      const v128_t num = wasm_i32x4_mul(sa, c255);
+      v128_t q = wasm_i32x4_trunc_sat_f32x4(wasm_f32x4_div(
+          wasm_f32x4_convert_i32x4(num), wasm_f32x4_convert_i32x4(du_safe)));
