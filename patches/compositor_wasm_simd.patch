+      const v128_t s_lo = wasm_u16x8_extend_low_u8x16(s);
+      const v128_t s_hi = wasm_u16x8_extend_high_u8x16(s);
+      const v128_t d_lo = wasm_u16x8_extend_low_u8x16(d);
+      const v128_t d_hi = wasm_u16x8_extend_high_u8x16(d);
