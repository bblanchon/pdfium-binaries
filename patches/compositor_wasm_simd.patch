+                                       Div255U32(wasm_i32x4_mul(da, sa)));
+      // Lanes with du == 0 are fully masked out below; make them safe to
+      // divide by.
+      const v128_t du_safe =
+          wasm_v128_bitselect(one, du, wasm_i32x4_eq(du, zero));
