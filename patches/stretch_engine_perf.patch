+// The horizontal stretch pass visits every destination column once per
+// source row, and the modal tap counts per column are 1 (no scaling in this
+// axis) and 2 (bilinear interpolation). At those trip counts the per-column
+// work around the multiply-adds -- dispatching on the tap count and building
+// a checked source window -- costs more than the multiply-adds themselves,
+// and the weight table does not change between rows, so
+// CStretchEngine::PlanHorzRuns() hoists that work out of the row loop: it
+// partitions the columns once into maximal runs of 1-tap and 2-tap columns,
+// and ContinueStretchHorz() replays the runs for every row as straight-line
+// loops. Columns with any other tap count, and runs too short to pay for
+// their setup, stay on the generic per-column path (`taps == 0`).
+struct StretchHorzRun {
+  uint32_t length;     // Destination columns this run covers.
+  uint32_t taps;       // Taps per column: 1 or 2, or 0 for the generic path.
+  uint32_t src_first;  // taps != 0: the first source pixel the run reads.
+  uint32_t src_count;  // taps != 0: source pixels covering all its windows.
+};
+FX_DATA_PARTITION_EXCEPTION(StretchHorzRun);
+
+// Per-column data for the `taps != 0` runs, in destination-column order: the
+// column's first tapped source pixel relative to its run's `src_first`, and
+// its weights, copied verbatim from the weight table.
+struct StretchHorzRunColumn {
+  uint32_t rel_src;
+  uint32_t weight0;
+  uint32_t weight1;  // Zero (and unread) in 1-tap runs.
+};
+FX_DATA_PARTITION_EXCEPTION(StretchHorzRunColumn);
