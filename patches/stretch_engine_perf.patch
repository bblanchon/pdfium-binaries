+void CStretchEngine::PlanHorzRuns() {
+  horz_runs_.clear();
+  horz_run_columns_.clear();
+  // Only the two transform methods below have run kernels in
+  // ContinueStretchHorz(); the others keep their original per-column loops
+  // and need no plan.
+  if (trans_method_ != TransformMethod::k8BppTo8Bpp &&
+      trans_method_ != TransformMethod::kManyBpptoManyBpp) {
+    return;
+  }
 
+  // Planning pays a fixed per-engine cost -- two walks of the weight table
+  // and the plan allocations -- that only the row loop can amortize, one
+  // replay per source row. An engine whose total work (destination columns
+  // times source rows) is small never earns that back, so such engines stay
+  // wholly on the generic path: a single generic run covering every column.
+  // Documents drawing many one-row engines otherwise pay the plan cost per
+  // engine and regress by double digits.
+  static constexpr uint32_t kMinPlanWork = 4096;
+  const uint32_t dest_cols =
+      static_cast<uint32_t>(dest_clip_.right - dest_clip_.left);
+  const uint32_t src_rows =
+      static_cast<uint32_t>(src_clip_.bottom - src_clip_.top);
+  if (static_cast<uint64_t>(dest_cols) * src_rows < kMinPlanWork) {
+    horz_runs_.push_back({dest_cols, 0, 0, 0});
+    return;
+  }
+
+  // A run shorter than this stays on the generic path: its per-row setup --
+  // three span constructions -- would cost more than the per-column dispatch
+  // it replaces.
+  static constexpr uint32_t kMinRunLength = 4;
+
+  // First pass: partition the destination columns into maximal runs of
+  // columns sharing a tap count of 1 or 2; every other tap count (including
+  // an empty weight range) goes to the generic path. Then demote runs
+  // shorter than `kMinRunLength` and merge neighboring generic runs.
+  DataVector<StretchHorzRun> runs;
+  for (int col = dest_clip_.left; col < dest_clip_.right; ++col) {
+    const size_t weight_count =
+        weight_table_.GetPixelWeight(col)->GetWeights().size();
+    const uint32_t taps = weight_count == 1 || weight_count == 2
+                              ? static_cast<uint32_t>(weight_count)
+                              : 0;
+    if (!runs.empty() && runs.back().taps == taps) {
+      ++runs.back().length;
+    } else {
+      runs.push_back({/*length=*/1, taps, /*src_first=*/0, /*src_count=*/0});
+    }
+  }
+  horz_runs_.reserve(runs.size());
+  for (const StretchHorzRun& run : runs) {
+    const uint32_t taps = run.length < kMinRunLength ? 0u : run.taps;
+    if (taps == 0 && !horz_runs_.empty() && horz_runs_.back().taps == 0) {
+      horz_runs_.back().length += run.length;
+    } else {
+      horz_runs_.push_back({run.length, taps, 0, 0});
+    }
+  }
+
+  // Second pass: for each remaining 1- or 2-tap run, bound the window of
+  // source pixels its columns read -- mirrored destinations walk the source
+  // backwards, so this is a min/max, not first/last -- and record each
+  // column's window offset and weights. The offsets and weights are copied
+  // verbatim from `weight_table_`, so a run kernel taps exactly the pixels,
+  // with exactly the weights, that the generic path taps.
+  size_t planned_columns = 0;
+  for (const StretchHorzRun& run : horz_runs_) {
+    if (run.taps != 0) {
+      planned_columns += run.length;
+    }
+  }
+  horz_run_columns_.reserve(planned_columns);
+  int col = dest_clip_.left;
+  for (StretchHorzRun& run : horz_runs_) {
+    if (run.taps == 0) {
+      col += static_cast<int>(run.length);
+      continue;
+    }
+    size_t src_first = weight_table_.GetPixelWeight(col)->GetSrcStart();
+    size_t src_last = src_first;
+    for (uint32_t i = 1; i < run.length; ++i) {
+      const size_t src_start =
+          weight_table_.GetPixelWeight(col + static_cast<int>(i))
+              ->GetSrcStart();
+      src_first = std::min(src_first, src_start);
+      src_last = std::max(src_last, src_start);
+    }
+    run.src_first = static_cast<uint32_t>(src_first);
+    run.src_count = static_cast<uint32_t>(src_last - src_first + run.taps);
+    for (uint32_t i = 0; i < run.length; ++i) {
+      const PixelWeight* pWeights =
+          weight_table_.GetPixelWeight(col + static_cast<int>(i));
+      pdfium::span<const uint32_t> weights = pWeights->GetWeights();
+      horz_run_columns_.push_back(
+          {static_cast<uint32_t>(pWeights->GetSrcStart() - src_first),
+           weights[0], run.taps == 2 ? weights[1] : 0u});
+    }
+    col += static_cast<int>(run.length);
+  }
