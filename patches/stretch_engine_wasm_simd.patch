+// Accumulates `weight * src[i]` into `acc[i]`. StretchVert() calls this once
+// per tap with a whole destination row, so it is the innermost loop of the
+// vertical pass.
+//
+// The scalar form below is what every other target gets, and it
+// auto-vectorizes there. LLVM's wasm backend does not widen it as
+// aggressively, so under -msimd128 drive the widening directly: load 16
+// source bytes, extend u8 -> u32 in four steps, and multiply-add against the
+// splatted weight. Products fit in 32 bits (a full accumulator is at most
+// 255 << kFixedPointBits), and per byte the additions happen in the same
+// order either way, so both forms produce identical output.
+void AccumulateWeightedRow(pdfium::span<uint32_t> acc,
+                           pdfium::span<const uint8_t> src,
+                           uint32_t weight) {
+#if defined(__wasm_simd128__)
+  constexpr size_t kStep = 16;
+  const size_t vector_len = src.size() - src.size() % kStep;
+  const v128_t vw = wasm_i32x4_splat(static_cast<int32_t>(weight));
+  for (size_t i = 0; i < vector_len; i += kStep) {
+    const v128_t bytes = wasm_v128_load(src.subspan(i, kStep).data());
+    const v128_t lo16 = wasm_u16x8_extend_low_u8x16(bytes);
+    const v128_t hi16 = wasm_u16x8_extend_high_u8x16(bytes);
+    const v128_t widened[4] = {
+        wasm_u32x4_extend_low_u16x8(lo16), wasm_u32x4_extend_high_u16x8(lo16),
+        wasm_u32x4_extend_low_u16x8(hi16), wasm_u32x4_extend_high_u16x8(hi16)};
+    for (size_t lane = 0; lane < 4; ++lane) {
+      uint32_t* dest = acc.subspan(i + lane * 4, 4u).data();
+      wasm_v128_store(dest, wasm_i32x4_add(wasm_v128_load(dest),
+                                           wasm_i32x4_mul(widened[lane], vw)));
+    }
+  }
+  acc = acc.subspan(vector_len);
+  src = src.subspan(vector_len);
+#endif
+  for (auto [dest, src_byte] : fxcrt::Zip(acc, src)) {
+    dest += weight * src_byte;
+  }
+}
+
