+#if defined(__wasm_simd128__)
+// Precomputed gather plan for the SIMD run kernels in ContinueStretchHorz():
+// each group covers four consecutive destination columns of a 1- or 2-tap
+// run. `idx[t]` are i8x16.swizzle lane indices that pull the four columns'
+// tap-t source bytes out of the single 16-byte register loaded from the
+// run's source window at `src_byte_base`, arranged as four 32-bit lanes of
+// [blue, green, red, 0] (or [gray, 0, 0, 0] for 8bpp); an index of 0xFF
+// yields a zero byte. `weights[t]` are the four columns' tap-t weights in
+// matching lane order, copied verbatim from the run column plan. A group
+// whose four source windows fit one 16-byte load has `kind` == 1; one that
+// needs two (its indices then span 0..31, and the kernel combines
+// swizzle(lo, idx) with swizzle(hi, idx - 16), each register again yielding
+// zero for indices past it) has `kind` == 2; one that fits neither is
+// executed by the scalar loop (`kind` == 0).
+struct StretchHorzWasmGroup {
+  uint8_t idx[2][16];
+  uint32_t weights[2][4];
+  uint32_t src_byte_base;
+  uint32_t kind;
+};
+FX_DATA_PARTITION_EXCEPTION(StretchHorzWasmGroup);
