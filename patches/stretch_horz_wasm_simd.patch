+#if defined(__wasm_simd128__)
+            // Vectorize the tap loop across channels rather than across
+            // pixels: each tap loads the source pixel's 4 bytes, extends
+            // u8 -> u32 and multiply-accumulates against the splatted
+            // weight, so lanes 0-2 end up holding exactly the scalar
+            // path's dest_b/dest_g/dest_r (lane 3 is the ignored 4th
+            // byte). Same arithmetic in the same order. Only available
+            // for 4-byte source pixels, since the load reads 4 bytes.
+            if constexpr (sizeof(*window.data()) == 4) {
+              v128_t acc = wasm_i64x2_const(0, 0);
+              for (auto [pixel_weight, src] : fxcrt::Zip(weights, window)) {
+                const v128_t px = wasm_u32x4_extend_low_u16x8(
+                    wasm_u16x8_extend_low_u8x16(wasm_v128_load32_zero(&src)));
