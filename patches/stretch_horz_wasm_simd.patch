+  DataVector<uint8_t> horz_run_has_groups_;
+  DataVector<StretchHorzWasmGroup> horz_wasm_groups_;
+#endif
 };
 
 #endif  // CORE_FXGE_DIB_CSTRETCHENGINE_H_
