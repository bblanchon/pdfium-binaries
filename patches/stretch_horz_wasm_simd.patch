+              }
+              dest_b = static_cast<uint32_t>(wasm_i32x4_extract_lane(acc, 0));
+              dest_g = static_cast<uint32_t>(wasm_i32x4_extract_lane(acc, 1));
+              dest_r = static_cast<uint32_t>(wasm_i32x4_extract_lane(acc, 2));
+            } else
+#endif
+            {
+              for (auto [pixel_weight, src] : fxcrt::Zip(weights, window)) {
+                dest_b += pixel_weight * src.blue;
