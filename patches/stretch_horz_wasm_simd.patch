+#if defined(__wasm_simd128__)
+void CStretchEngine::BuildHorzWasmGroups(
+    const StretchHorzRun& run,
+    pdfium::span<const StretchHorzRunColumn> columns) {
+  // The kernels gather the blue/green/red bytes (or the single 8bpp byte);
+  // a 4-byte source's 4th byte is never read, matching the scalar loops.
+  const uint32_t bpp = trans_method_ == TransformMethod::k8BppTo8Bpp
+                           ? 1u
+                           : static_cast<uint32_t>(src_bpp_ / 8);
+  const uint32_t gathered = bpp == 1 ? 1u : 3u;
+  const uint32_t window_bytes = run.src_count * bpp;
+  const size_t group_count = columns.size() / 4;
+
+  // First pass: how would each group execute? Everything a group's four
+  // windows read must fit the registers a kernel gathers from: one 16-byte
+  // load (kind 1), two (kind 2), or neither (kind 0, the scalar loop). The
+  // load is kept inside the run's source window by sliding its base left,
+  // so the window itself must also cover the load. If the run would execute
+  // mostly scalar -- upscales fit kind 1, mild downscales kind 2, so runs
+  // are all-or-nothing in practice -- planning it is all cost: emit no
+  // groups and leave the run on the per-run scalar loops, which also skips
+  // the plan's index construction below.
+  auto group_kind = [&](size_t g) -> uint32_t {
+    uint32_t min_rel = columns[g * 4].rel_src;
+    uint32_t max_rel = min_rel;
+    for (size_t k = 1; k < 4; ++k) {
+      min_rel = std::min(min_rel, columns[g * 4 + k].rel_src);
+      max_rel = std::max(max_rel, columns[g * 4 + k].rel_src);
+    }
+    const uint32_t span_bytes = (max_rel + run.taps - min_rel) * bpp;
+    if (span_bytes <= 16 && window_bytes >= 16) {
+      return 1;
+    }
+    if (span_bytes <= 32 && window_bytes >= 32) {
+      return 2;
+    }
+    return 0;
+  };
+  size_t simd_groups = 0;
+  for (size_t g = 0; g < group_count; ++g) {
+    simd_groups += group_kind(g) != 0;
+  }
+  if (simd_groups * 4 < group_count * 3) {
+    horz_run_has_groups_.push_back(0);
+    return;
+  }
+  horz_run_has_groups_.push_back(1);
+
+  for (size_t g = 0; g < group_count; ++g) {
+    StretchHorzWasmGroup group;
+    std::fill_n(group.idx[0], 32, uint8_t{0xFF});
+    group.kind = group_kind(g);
+    group.src_byte_base = 0;
+    if (group.kind != 0) {
+      uint32_t min_rel = columns[g * 4].rel_src;
+      for (size_t k = 1; k < 4; ++k) {
+        min_rel = std::min(min_rel, columns[g * 4 + k].rel_src);
+      }
+      const uint32_t load_bytes = group.kind == 1 ? 16 : 32;
+      group.src_byte_base =
+          std::min(min_rel * bpp, window_bytes - load_bytes);
+    }
+    for (size_t k = 0; k < 4; ++k) {
+      const StretchHorzRunColumn& column = columns[g * 4 + k];
+      group.weights[0][k] = column.weight0;
+      group.weights[1][k] = column.weight1;
+      if (group.kind == 0) {
+        continue;
+      }
+      for (uint32_t t = 0; t < run.taps; ++t) {
+        const uint32_t src_byte =
+            (column.rel_src + t) * bpp - group.src_byte_base;
+        for (uint32_t c = 0; c < gathered; ++c) {
+          group.idx[t][k * 4 + c] = static_cast<uint8_t>(src_byte + c);
+        }
+      }
+    }
+    horz_wasm_groups_.push_back(group);
+  }
+}
