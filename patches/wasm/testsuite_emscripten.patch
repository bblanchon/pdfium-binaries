diff --git a/testing/gtest/include/gtest/gtest.h b/testing/gtest/include/gtest/gtest.h
index 47062803f..95e32f979 100644
--- a/testing/gtest/include/gtest/gtest.h
+++ b/testing/gtest/include/gtest/gtest.h
@@ -8,3 +8,14 @@
 // third_party/googletest.
 
 #include "third_party/googletest/src/googletest/include/gtest/gtest.h"
+
+// Emscripten has no fork(), so googletest disables death tests and does not
+// define EXPECT_DEATH. PDFium's tests use EXPECT_DEATH unguarded; map it to
+// the IF_SUPPORTED variant, which still compiles the statement but skips it
+// (with a warning) on platforms without death test support.
+#if defined(__EMSCRIPTEN__) && !defined(EXPECT_DEATH)
+#define EXPECT_DEATH(statement, matcher) \
+  EXPECT_DEATH_IF_SUPPORTED(statement, matcher)
+#define ASSERT_DEATH(statement, matcher) \
+  ASSERT_DEATH_IF_SUPPORTED(statement, matcher)
+#endif
