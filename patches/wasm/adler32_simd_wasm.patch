+#elif defined(ADLER32_SIMD_WASM)
+
+#include <wasm_simd128.h>
+
+uint32_t ZLIB_INTERNAL adler32_simd_(  /* WASM SIMD128 */
+    uint32_t adler,
+    const unsigned char *buf,
+    z_size_t len)
+{
+    /*
+     * Split Adler-32 into component sums. Same block structure as the NEON
+     * implementation above; wasm loads have no alignment requirement, so the
+     * serial alignment prologue is unnecessary.
+     */
+    uint32_t s1 = adler & 0xffff;
+    uint32_t s2 = adler >> 16;
+
+    /*
+     * Process the data in blocks.
+     */
+    const unsigned BLOCK_SIZE = 1 << 5;
+
+    z_size_t blocks = len / BLOCK_SIZE;
+    len -= blocks * BLOCK_SIZE;
+
+    while (blocks)
+    {
+        unsigned n = NMAX / BLOCK_SIZE;  /* The NMAX constraint. */
+        if (n > blocks)
+            n = (unsigned) blocks;
+        blocks -= n;
+
+        v128_t v_s2 = wasm_u32x4_make(0, 0, 0, s1 * n);
+        v128_t v_s1 = wasm_i32x4_splat(0);
+
+        v128_t v_column_sum_1 = wasm_i16x8_splat(0);
+        v128_t v_column_sum_2 = wasm_i16x8_splat(0);
+        v128_t v_column_sum_3 = wasm_i16x8_splat(0);
+        v128_t v_column_sum_4 = wasm_i16x8_splat(0);
+
+        do {
+            /*
+             * Load 32 input bytes.
+             */
+            const v128_t bytes1 = wasm_v128_load(buf);
+            const v128_t bytes2 = wasm_v128_load(buf + 16);
+
+            /*
+             * Add previous block byte sum to v_s2.
+             */
+            v_s2 = wasm_i32x4_add(v_s2, v_s1);
+
+            /*
+             * Horizontally add the bytes for s1.
+             */
+            v_s1 = wasm_i32x4_add(
+                v_s1, wasm_u32x4_extadd_pairwise_u16x8(wasm_i16x8_add(
+                          wasm_u16x8_extadd_pairwise_u8x16(bytes1),
+                          wasm_u16x8_extadd_pairwise_u8x16(bytes2))));
+
+            /*
+             * Vertically add the bytes for s2.
+             */
+            v_column_sum_1 = wasm_i16x8_add(
+                v_column_sum_1, wasm_u16x8_extend_low_u8x16(bytes1));
+            v_column_sum_2 = wasm_i16x8_add(
+                v_column_sum_2, wasm_u16x8_extend_high_u8x16(bytes1));
+            v_column_sum_3 = wasm_i16x8_add(
+                v_column_sum_3, wasm_u16x8_extend_low_u8x16(bytes2));
+            v_column_sum_4 = wasm_i16x8_add(
+                v_column_sum_4, wasm_u16x8_extend_high_u8x16(bytes2));
+
+            buf += BLOCK_SIZE;
+
+        } while (--n);
+
+        v_s2 = wasm_i32x4_shl(v_s2, 5);
+
+        /*
+         * Multiply-add bytes by [ 32, 31, 30, ... ] for s2.
+         */
+        const v128_t weights_1 =
+            wasm_u16x8_make(32, 31, 30, 29, 28, 27, 26, 25);
+        const v128_t weights_2 =
+            wasm_u16x8_make(24, 23, 22, 21, 20, 19, 18, 17);
+        const v128_t weights_3 = wasm_u16x8_make(16, 15, 14, 13, 12, 11, 10, 9);
+        const v128_t weights_4 = wasm_u16x8_make(8, 7, 6, 5, 4, 3, 2, 1);
+        v_s2 = wasm_i32x4_add(
+            v_s2, wasm_u32x4_extmul_low_u16x8(v_column_sum_1, weights_1));
+        v_s2 = wasm_i32x4_add(
+            v_s2, wasm_u32x4_extmul_high_u16x8(v_column_sum_1, weights_1));
+        v_s2 = wasm_i32x4_add(
+            v_s2, wasm_u32x4_extmul_low_u16x8(v_column_sum_2, weights_2));
+        v_s2 = wasm_i32x4_add(
+            v_s2, wasm_u32x4_extmul_high_u16x8(v_column_sum_2, weights_2));
+        v_s2 = wasm_i32x4_add(
+            v_s2, wasm_u32x4_extmul_low_u16x8(v_column_sum_3, weights_3));
+        v_s2 = wasm_i32x4_add(
+            v_s2, wasm_u32x4_extmul_high_u16x8(v_column_sum_3, weights_3));
+        v_s2 = wasm_i32x4_add(
+            v_s2, wasm_u32x4_extmul_low_u16x8(v_column_sum_4, weights_4));
+        v_s2 = wasm_i32x4_add(
+            v_s2, wasm_u32x4_extmul_high_u16x8(v_column_sum_4, weights_4));
+
+        /*
+         * Sum epi32 ints v_s1(s2) and accumulate in s1(s2).
+         */
+        s1 += wasm_u32x4_extract_lane(v_s1, 0) +
+              wasm_u32x4_extract_lane(v_s1, 1) +
+              wasm_u32x4_extract_lane(v_s1, 2) +
+              wasm_u32x4_extract_lane(v_s1, 3);
+        s2 += wasm_u32x4_extract_lane(v_s2, 0) +
+              wasm_u32x4_extract_lane(v_s2, 1) +
+              wasm_u32x4_extract_lane(v_s2, 2) +
+              wasm_u32x4_extract_lane(v_s2, 3);
+
+        /*
+         * Reduce.
+         */
+        s1 %= BASE;
+        s2 %= BASE;
+    }
+
+    /*
+     * Handle leftover data.
+     */
+    if (len) {
+        while (len--) {
+            s2 += (s1 += *buf++);
+        }
+
+        if (s1 >= BASE)
+            s1 -= BASE;
+        s2 %= BASE;
+    }
+
+    /*
+     * Return the recombined sums.
+     */
+    return s1 | (s2 << 16);
+}
+
 #elif defined(ADLER32_SIMD_RVV)
 #include <riscv_vector.h>
 
