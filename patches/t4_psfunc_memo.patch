+bool CPDF_PSFunc::MemoEnabled() const {
+  return inputs_ <= 4 && outputs_ <= 8;
+}
+
 bool CPDF_PSFunc::v_Call(pdfium::span<const float> inputs,
                          pdfium::span<float> results) const {
+  MemoEntry* insert_at = nullptr;
+  std::array<uint32_t, 4> in_bits = {};
+  if (MemoEnabled()) {
+    uint64_t h = 0xcbf29ce484222325ull;
+    for (uint32_t i = 0; i < inputs_; i++) {
+      memcpy(&in_bits[i], &inputs[i], sizeof(uint32_t));
+      h = (h ^ in_bits[i]) * 0x100000001b3ull;
+    }
+    if (memo_.empty()) {
+      memo_.resize(kMemoSize);
+    }
+    for (uint32_t probe = 0; probe < kMemoProbes; ++probe) {
+      MemoEntry& e = memo_[(h + probe) & (kMemoSize - 1)];
+      if (e.used == 0) {
+        insert_at = &e;
+        break;
+      }
+      if (e.used == 1 + outputs_ && e.in_bits == in_bits) {
+        if (!e.ok) {
+          return false;
+        }
+        for (uint32_t i = 0; i < outputs_; i++) {
+          results[i] = e.out[i];
+        }
+        return true;
+      }
+    }
+  }
