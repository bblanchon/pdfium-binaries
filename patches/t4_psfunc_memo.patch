-  if (ps_.GetStackSize() < outputs_) {
-    return false;
+  const bool ok = ps_.GetStackSize() >= outputs_;
+  if (ok) {
+    for (uint32_t i = 0; i < outputs_; i++) {
+      results[outputs_ - i - 1] = ps_.Pop();
+    }
   }
