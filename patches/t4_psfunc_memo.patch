  private:
+  // Exact-match memo for v_Call(). A parsed program is a pure function of
+  // its pushed inputs, so the raw input bit patterns fully determine the
+  // outputs; a hit replays exactly what Execute() produced for the same
+  // inputs. Bounded: engages for at most 4 inputs and 8 outputs, insertion
+  // stops when the probe window fills, and the table is lazily allocated.
+  // The tail documents evaluate the same tuples millions of times.
+  struct MemoEntry {
+    std::array<uint32_t, 4> in_bits;
+    std::array<float, 8> out;
+    uint8_t used = 0;  // 0 = empty; else 1 + number of outputs
+    bool ok = false;
+  };
+  bool MemoEnabled() const;
+
   mutable CPDF_PSEngine ps_;  // Pre-initialized scratch space for v_Call().
+  mutable std::vector<MemoEntry> memo_;
 };
 
