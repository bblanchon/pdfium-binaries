+    // Fully opaque source: AlphaUnion() is 255, the ratio is 255 and
+    // AlphaMerge(..., 255) returns the source value, so this is exactly a
+    // copy - without the integer divisions the general path costs.
+    output.blue = input.blue;
+    output.green = input.green;
+    output.red = input.red;
+    output.alpha = 255;
+    return;
+  }
   const uint8_t dest_alpha = AlphaUnion(output.alpha, src_alpha);
-  const int alpha_ratio = src_alpha * 255 / dest_alpha;
+  const int alpha_ratio =
+      kAlphaRatioTable.Divide(src_alpha * 255, dest_alpha);
   AlphaMergeToDest(input, output, alpha_ratio);
   output.alpha = dest_alpha;
 }
