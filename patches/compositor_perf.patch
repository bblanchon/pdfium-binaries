+// Exact replacement for `n / d` with d in [1, 255] and n in [0, 65025]:
+// multiply by a precomputed 24-bit reciprocal, then correct the at most one
+// unit of underestimation. This avoids a hardware integer division on the
+// per-pixel alpha compositing path (the compiler already strength-reduces
+// the constant divisions by 255).
+class AlphaRatioTable {
+ public:
+  constexpr AlphaRatioTable() {
+    for (uint32_t d = 1; d < 256; ++d) {
+      inv_[d] = (1u << 24) / d;
+    }
+  }
+
+  // floor(n / d), exact for n in [0, 65025], d in [1, 255].
+  uint32_t Divide(uint32_t n, uint32_t d) const {
+    uint32_t q = (n * inv_[d]) >> 24;
+    q += (q + 1) * d <= n ? 1 : 0;
+    return q;
+  }
+
+ private:
+  uint32_t inv_[256] = {};
+};
+
+constexpr AlphaRatioTable kAlphaRatioTable;
